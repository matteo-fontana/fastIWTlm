useDynLib(fastIWTlm, .registration = TRUE)

importFrom(Rcpp, sourceCpp)

## ggplot2 (plotting layer) + the autoplot generic (re-exported so callers can
## use autoplot() after only library(fastIWTlm), the standard ggplot2 pattern)
import(ggplot2)
importFrom(ggplot2, autoplot)
export(autoplot)

## data.table (used by the plotting layer)
import(data.table)

## base pkgs
importFrom(stats, model.matrix, model.frame, model.response, terms,
           lm.fit, rbinom, coef, na.omit)
importFrom(graphics, par, plot)
importFrom(grDevices, rainbow, devAskNewPage)
importFrom(utils, globalVariables)

## exported functions
export(fastIWTlm)
export(arrange_IWTlm)

## S3 methods
S3method(summary, IWTlm)
S3method(autoplot, IWTlm)
S3method(plot, IWTlm)
